{
  "name": "fon-raspored-t3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build",
    "db:generate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:push": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js db push",
    "db:studio": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js studio",
    "db:validate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js validate",
    "db:import": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-catalog.mjs",
    "schedule:download": "python3 scripts/download-schedule.py",
    "dev": "next dev",
    "docker:dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/docker.mjs dev",
    "docker:prod": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/docker.mjs prod",
    "docker:migrate:prod": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/docker.mjs migrate-prod",
    "docker:import:dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/docker.mjs import-dev",
    "docker:import:prod": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/docker.mjs import-prod",
    "docker:down": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/docker.mjs down",
    "docker:db": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/docker.mjs database",
    "postinstall": "npm run db:generate",
    "lint": "next lint",
    "test": "node --test tests/*.test.cjs",
    "perf:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/benchmark-api.mjs",
    "start": "next start"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.7.2",
    "@clerk/themes": "^2.1.35",
    "@prisma/client": "^5.14.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@tanstack/react-query": "^5.50.0",
    "@trpc/client": "^11.0.0-rc.446",
    "@trpc/react-query": "^11.0.0-rc.446",
    "@trpc/server": "^11.0.0-rc.446",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "geist": "^1.3.0",
    "jotai": "^2.10.0",
    "lucide-react": "^0.451.0",
    "next": "^14.2.35",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "tailwind-merge": "^2.5.3",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "@types/eslint": "^8.56.10",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.5.3"
  },
  "ct3aMetadata": {
    "initVersion": "7.37.0"
  },
  "packageManager": "npm@10.2.5"
}
